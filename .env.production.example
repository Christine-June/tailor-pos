# Copy to .env on the server and fill in. Never commit .env (it's in .gitignore).
# Make the random values with:   openssl rand -hex 32

# The domain staff will open, pointed at this server's IP address (an "A" record at your DNS provider).
SITE_ADDRESS=pos.yourshop.co.ke
PUBLIC_URL=https://pos.yourshop.co.ke

# Hex only (openssl rand -hex 24) so it is safe inside the database URL.
POSTGRES_PASSWORD=
SECRET_KEY=
JWT_SECRET_KEY=

# Optional: error monitoring. Create a free project at sentry.io (platform: Flask) and paste its DSN.
SENTRY_DSN=
# Optional: shown in error reports, e.g. the git commit you deployed.
RELEASE=

# Daily backup time (shop's local time) and how many days of backups to keep on the server.
TZ=Africa/Nairobi
BACKUP_TIME=02:30
BACKUP_KEEP_DAYS=14

# API worker processes. 3 suits a 1-2 CPU server; roughly 2 x CPUs + 1.
WEB_WORKERS=3
