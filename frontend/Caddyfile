# SITE_ADDRESS is the domain, e.g. pos.yourshop.co.ke. Caddy then gets a free HTTPS certificate
# from Let's Encrypt and renews it by itself. For a local test without HTTPS use ":80".
{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# Everything comes from this server: no third-party scripts, fonts or trackers.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	handle /api/* {
		reverse_proxy api:5000 {
			# Gunicorn's own timeout is 60 s; fail a little sooner so the app can retry.
			transport http {
				response_header_timeout 55s
			}
		}
	}

	handle {
		root * /srv
		# Built files have a content hash in their name: cache them for a year.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# Everything else (the page, service worker, file list) is checked on every load so updates arrive.
		@other not path /assets/*
		header @other Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
