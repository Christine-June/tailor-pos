# Copy to .env and fill in. Never commit .env.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://tailor:tailor@localhost:5432/tailor_pos
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=
CORS_ORIGINS=http://localhost:5173
# Only "true" when the server runs inside the shop's own network.
ALLOW_DIRECT_PRINT=false
